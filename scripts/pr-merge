#!/usr/bin/env bash
# pr-merge: guard-check, wait for checks, then squash-merge a pull request.
#
# Usage: pr-merge <repo-dir | owner/repo> <pr-number>
#
# Steps:
#   1. Resolve owner/repo (from a local clone/worktree directory, or given directly).
#   2. Run the local private-content guard: `guard pr <owner/repo> <pr>`.
#      The guard is taken from $AWKIT_GUARD if set, else `guard` on PATH.
#      A configured guard that fails or is missing stops the merge (fail closed);
#      with no guard installed at all, a warning is printed and the merge continues.
#      Exception: if `guard pr` fails only because GitHub refuses to serve the diff
#      (HTTP 406 "diff exceeded the maximum number of lines": a PR that modifies existing
#      files and exceeds GitHub's 20,000-line diff limit; the 300-file limit is not
#      covered), scan locally instead: fetch the PR head, run
#      `guard range <merge-base>..<head>` (added lines and commit messages) and
#      `guard text` on the title and body. This needs a local clone as the target;
#      any finding or error still stops the merge. The fetched
#      head must equal the head gh reports, and the scan is per commit (the range
#      is read with an empty work tree and index, so no checked-out file, such as a
#      .gitattributes, changes what is scanned).
#   3. Wait for all checks: `gh pr checks <pr> --watch --fail-fast`.
#   4. Squash-merge: `gh pr merge <pr> --squash --match-head-commit <sha>` (never
#      --admin, never --delete-branch: merging and cleanup are separate steps). The
#      merge only happens if the PR head is still the commit the guard checked. After
#      the call the PR is always re-read (state, merge commit, head). If gh exited 0
#      but the PR is not MERGED with a merge commit and the checked head (e.g. queued
#      in a merge queue or set to auto-merge), or the re-read fails, a warning is
#      printed, step 5 is skipped and the exit status stays 0. If gh exits non-zero,
#      MERGED with a merge commit and the checked head counts as merged (warning);
#      anything else, or a failed re-read, is a failure and gh's output is shown, and
#      nothing is deleted. Accepted race: if someone else merges
#      the same head between the guard and our merge, the re-read accepts it; the
#      content is identical to the guarded content.
#   5. Delete the remote head branch, as --delete-branch used to: `gh api -X DELETE
#      repos/<owner>/<repo>/git/refs/heads/<branch>`. Only for a PR from the same
#      repository (never a fork's branch), and never the default branch, the base
#      branch or a protected branch. HTTP 404, and 422 "Reference does not exist",
#      mean the branch is already gone (e.g. delete_branch_on_merge) and count as
#      success. Any other failure, or a lookup that cannot decide whether deleting is
#      safe, only prints a warning: the merge is done, so the exit status stays 0.
#      Local branches are never touched (gh's --delete-branch also switched to the
#      base branch and deleted the local head branch; this script runs no local git
#      commands here). Note for stacked PRs: deleting the head branch closes PRs based
#      on it, so retarget children first.
#
# Exit status: 0 once the PR is merged (even if the branch could not be deleted, or if
# the merge call returned 0 but the PR is not merged yet, e.g. queued); 1 on any
# failure; 2 on usage errors.

set -euo pipefail

prog="pr-merge"

usage() {
  echo "usage: $prog <repo-dir | owner/repo> <pr-number>" >&2
  exit 2
}

die() {
  echo "$prog: error: $*" >&2
  exit 1
}

warn() {
  echo "$prog: warning: $*" >&2
}

[ "$#" -eq 2 ] || usage
target=$1
pr=$2

[[ "$pr" =~ ^[1-9][0-9]*$ ]] || die "PR number must be a positive integer, got '$pr'"
command -v gh > /dev/null 2>&1 || die "gh (GitHub CLI) is not installed; see https://cli.github.com"

# 1. Resolve owner/repo.
if [ -d "$target" ]; then
  repo=$(cd "$target" && gh repo view --json nameWithOwner --jq .nameWithOwner) ||
    die "could not resolve owner/repo from directory '$target' (is it a clone with a GitHub remote?)"
elif [[ "$target" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  repo=$target
else
  die "'$target' is neither a directory nor an owner/repo name"
fi

head_sha=$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid) ||
  die "could not read PR #$pr in $repo"
[ -n "$head_sha" ] || die "PR #$pr in $repo reports an empty head commit; not merging"
echo "$prog: $repo#$pr at ${head_sha}"

guard_out=""
scan_dir=""
merge_out=""
cleanup() {
  [ -z "$guard_out" ] || rm -f "$guard_out"
  [ -z "$scan_dir" ] || rm -rf "$scan_dir"
  [ -z "$merge_out" ] || rm -f "$merge_out"
}
trap cleanup EXIT

# Fallback for PRs whose diff GitHub refuses to serve: scan the same content locally.
# Fails closed: any missing prerequisite, finding or guard error stops the merge.
large_diff_guard() {
  [ -d "$target" ] ||
    die "the diff of $repo#$pr is too large for GitHub, and the local scan needs a local clone (pass a directory, not owner/repo); not merging"
  local base base_ref pr_ref fetched merge_base
  base=$(gh pr view "$pr" --repo "$repo" --json baseRefName --jq .baseRefName) ||
    die "could not read the base branch of $repo#$pr; not merging"
  [ -n "$base" ] || die "empty base branch for $repo#$pr; not merging"
  base_ref=refs/remotes/origin/$base
  pr_ref=refs/remotes/origin/pr/$pr
  git -C "$target" fetch --quiet --no-tags origin "+refs/heads/$base:$base_ref" "+refs/pull/$pr/head:$pr_ref" ||
    die "could not fetch '$base' and the head of $repo#$pr from origin; not merging"
  # The fetched PR head must be the commit that will be merged.
  fetched=$(git -C "$target" rev-parse --verify --quiet "$pr_ref^{commit}") ||
    die "could not resolve the fetched head of $repo#$pr; not merging"
  [ "$fetched" = "$head_sha" ] || die "fetched head $fetched does not match PR head $head_sha; not merging"
  merge_base=$(git -C "$target" merge-base "$base_ref" "$head_sha") ||
    die "no merge base between origin/$base and $head_sha; not merging"

  # Scan from an empty work tree so nothing PR-controlled (a checked-out
  # .gitattributes, for one) can change what the guard sees.
  local git_dir
  git_dir=$(git -C "$target" rev-parse --absolute-git-dir) ||
    die "could not locate the git directory of '$target'; not merging"
  scan_dir=$(mktemp -d) || die "could not create a temporary directory; not merging"
  # mktemp honors a relative TMPDIR; the scan runs after a cd, so make it absolute.
  scan_dir=$(cd "$scan_dir" && pwd -P) || die "could not resolve the temporary directory; not merging"
  echo "$prog: running guard: $guard_cmd range $merge_base..$head_sha"
  (cd "$scan_dir" &&
    GIT_DIR=$git_dir GIT_WORK_TREE=$scan_dir GIT_INDEX_FILE=$scan_dir/idx \
      "$guard_cmd" range "$merge_base..$head_sha") ||
    die "private-content guard failed on the commits of $repo#$pr; not merging"

  echo "$prog: running guard: $guard_cmd text - (title and body)"
  gh pr view "$pr" --repo "$repo" --json title,body --jq '.title + "\n\n" + (.body // "")' |
    "$guard_cmd" text - ||
    die "private-content guard failed on the title or body of $repo#$pr; not merging"
}

# 2. Private-content guard (local only; see architecture section 18.7).
guard_cmd=""
if [ -n "${AWKIT_GUARD:-}" ]; then
  if [ -x "$AWKIT_GUARD" ] || command -v "$AWKIT_GUARD" > /dev/null 2>&1; then
    guard_cmd=$AWKIT_GUARD
    # Make a relative path absolute now: the guard also runs after a cd.
    case $guard_cmd in
      */*) ;;
      *)
        p=$(command -v "$guard_cmd") || p=""
        [ -n "$p" ] || die "AWKIT_GUARD '$AWKIT_GUARD' is not found on PATH; refusing to merge"
        guard_cmd=$p
        ;;
    esac
    case $guard_cmd in
      /*) ;;
      *) guard_cmd=$PWD/${guard_cmd#./} ;;
    esac
  else
    die "AWKIT_GUARD is set to '$AWKIT_GUARD' but it is not an executable; refusing to merge"
  fi
elif command -v guard > /dev/null 2>&1; then
  guard_cmd=$(command -v guard)
  case $guard_cmd in
    /*) ;;
    *) guard_cmd=$PWD/${guard_cmd#./} ;;
  esac
fi

if [ -n "$guard_cmd" ]; then
  echo "$prog: running guard: $guard_cmd pr $repo $pr"
  guard_out=$(mktemp)
  if "$guard_cmd" pr "$repo" "$pr" 2> "$guard_out"; then
    cat "$guard_out" >&2
    echo "$prog: guard route: guard pr"
  else
    cat "$guard_out" >&2
    # Only GitHub's "diff too large" refusal (HTTP 406) allows the local fallback;
    # every other failure stays fatal.
    grep -qi 'diff exceeded the maximum number of lines' "$guard_out" ||
      die "private-content guard failed for $repo#$pr; not merging"
    echo "$prog: guard route: large-diff fallback (guard range + guard text)"
    large_diff_guard
  fi
else
  warn "no private-content guard installed (set AWKIT_GUARD or put 'guard' on PATH); continuing without it"
fi

# 3. Wait for every check to pass.
echo "$prog: waiting for checks on $repo#$pr"
gh pr checks "$pr" --repo "$repo" --watch --fail-fast ||
  die "checks did not pass for $repo#$pr (or none were reported); not merging"

# 4. Squash-merge, only if the head is unchanged since the guard ran.
echo "$prog: squash-merging $repo#$pr"
# No --delete-branch: the merge call does only the merge (branch cleanup is step 5). Exit
# 0 can still mean "queued" (merge queue, auto-merge) with the PR open, so after every
# call re-read the PR and accept only one that is MERGED, has a merge commit and whose
# head is the commit we asked gh to merge. Anything else is a failed merge after a
# non-zero exit, and a warning (no branch deletion, exit 0) after exit 0.
merge_out=$(mktemp)
# Everything printed from gh output is stripped of control characters first.
sanitize() { LC_ALL=C tr -c '[:print:]\n\t' '?'; }
do_delete=0
merge_rc=0
gh pr merge "$pr" --repo "$repo" --squash --match-head-commit "$head_sha" > "$merge_out" 2>&1 || merge_rc=$?
if [ "$merge_rc" -eq 0 ]; then
  sanitize < "$merge_out"
else
  sanitize < "$merge_out" >&2
fi
# '|' separates the fields: unlike a tab, it does not collapse an empty merge commit.
view_ok=1
view=$(gh pr view "$pr" --repo "$repo" --json state,mergeCommit,headRefOid \
  --jq '[.state, (.mergeCommit.oid // ""), .headRefOid] | join("|")' 2> /dev/null) || view_ok=0
view_state="" view_merge="" view_head=""
[ "$view_ok" -eq 0 ] || IFS='|' read -r view_state view_merge view_head <<< "$view"
if [ "$merge_rc" -eq 0 ]; then
  if [ "$view_ok" -eq 1 ] && [ "$view_state" = "MERGED" ] && [ -n "$view_merge" ] && [ "$view_head" = "$head_sha" ]; then
    do_delete=1
  else
    warn "merge call returned 0 but $repo#$pr is not merged (queued?) or its state could not be re-read; not deleting the head branch"
  fi
else
  [ "$view_ok" -eq 1 ] ||
    die "merge failed for $repo#$pr and its state could not be re-read (see gh output above)"
  if [ "$view_state" != "MERGED" ]; then
    die "merge failed for $repo#$pr (head changed since the guard ran, or merge not allowed; see gh output above)"
  fi
  [ -n "$view_merge" ] ||
    die "gh pr merge failed for $repo#$pr and the PR is MERGED but has no merge commit; not treating it as our merge"
  [ "$view_head" = "$head_sha" ] ||
    die "gh pr merge failed for $repo#$pr and the PR is merged, but its head $view_head is not the commit $head_sha that was checked; not treating it as our merge"
  warn "gh pr merge exited non-zero after $repo#$pr was merged (merge commit $view_merge); treating the merge as done. gh said: $(sanitize < "$merge_out" | tr '\n' ' ')"
  do_delete=1
fi

[ "$do_delete" -eq 0 ] || echo "$prog: merged $repo#$pr"

# 5. Delete the remote head branch. The merge is done, so nothing here may fail the run:
# every problem is a warning and the exit status stays 0.
# percent_encode: encode every byte except unreserved characters and '/', which stays
# literal in a ref path.
percent_encode() {
  local LC_ALL=C s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [A-Za-z0-9._~/-]) out+=$c ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

delete_head_branch() {
  local info cross base head default enc prot
  # Reuse the merge output buffer (removed by the exit trap) for gh's output.
  local delete_out=$merge_out
  info=$(gh pr view "$pr" --repo "$repo" --json isCrossRepository,baseRefName,headRefName \
    --jq '[(.isCrossRepository | tostring), .baseRefName, .headRefName] | join("\t")' 2> /dev/null) || info=""
  IFS=$'\t' read -r cross base head <<< "$info"
  # Branch names are PR-controlled: print them sanitized only.
  local shead
  if [ -z "$cross" ] || [ -z "$base" ] || [ -z "$head" ]; then
    warn "could not read the head branch of $repo#$pr; branch not deleted"
    return 0
  fi
  shead=$(printf '%s' "$head" | sanitize)
  if [ "$cross" != "false" ]; then
    echo "$prog: head branch '$shead' is in another repository; not deleting it"
    return 0
  fi
  default=$(gh repo view "$repo" --json defaultBranchRef --jq .defaultBranchRef.name 2> /dev/null) || default=""
  if [ -z "$default" ]; then
    warn "could not read the default branch of $repo; branch '$shead' not deleted"
    return 0
  fi
  if [ "$head" = "$default" ] || [ "$head" = "$base" ]; then
    echo "$prog: head branch '$shead' is the default or base branch; not deleting it"
    return 0
  fi
  enc=$(percent_encode "$head")
  # Safe to leave in place if the protection lookup fails for any reason but 404.
  if ! prot=$(gh api "repos/$repo/branches/$enc" --jq .protected 2> "$delete_out"); then
    if grep -q 'HTTP 404' "$delete_out"; then
      echo "$prog: head branch '$shead' is already gone"
    else
      warn "could not check whether branch '$shead' is protected; branch not deleted. gh said: $(sanitize < "$delete_out" | tr '\n' ' ')"
    fi
    return 0
  fi
  if [ "$prot" != "false" ]; then
    echo "$prog: head branch '$shead' is protected; not deleting it"
    return 0
  fi
  if gh api -X DELETE "repos/$repo/git/refs/heads/$enc" > "$delete_out" 2>&1; then
    echo "$prog: deleted branch $shead"
  elif grep -q 'HTTP 404' "$delete_out" ||
    { grep -q 'HTTP 422' "$delete_out" && grep -qi 'reference does not exist' "$delete_out"; }; then
    echo "$prog: head branch '$shead' is already gone"
  else
    warn "branch '$shead' not deleted ($repo#$pr is merged). gh said: $(sanitize < "$delete_out" | tr '\n' ' ')"
  fi
}
[ "$do_delete" -eq 0 ] || delete_head_branch
